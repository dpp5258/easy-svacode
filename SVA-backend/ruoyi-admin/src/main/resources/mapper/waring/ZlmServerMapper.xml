<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.waring.mapper.ZlmServerMapper">

    <resultMap id="ZlmServerResult" type="com.ruoyi.waring.domain.ZlmServer">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="app" column="app"/>
        <result property="host" column="host"/>
        <result property="api_port" column="api_port"/>
        <result property="media_http_port" column="media_http_port"/>
        <result property="media_rtsp_port" column="media_rtsp_port"/>
        <result property="secret" column="secret"/>
        <result property="enabled" column="enabled"/>
    </resultMap>

    <select id="selectEnabledById" resultMap="ZlmServerResult">
        SELECT
            id,
            name,
            app,
            host,
            api_port,
            media_http_port,
            media_rtsp_port,
            secret,
            enabled
        FROM zlm_server
        WHERE id = #{id}
          AND enabled = 1
        LIMIT 1
    </select>

    <select id="selectEnabledList" resultMap="ZlmServerResult">
        SELECT
            id,
            name,
            app,
            host,
            api_port,
            media_http_port,
            media_rtsp_port,
            secret,
            enabled
        FROM zlm_server
        WHERE enabled = 1
        ORDER BY id ASC
    </select>

    <select id="selectZlmServerById" resultMap="ZlmServerResult">
        SELECT
            id,
            name,
            app,
            host,
            api_port,
            media_http_port,
            media_rtsp_port,
            secret,
            enabled
        FROM zlm_server
        WHERE id = #{id}
        LIMIT 1
    </select>

    <!-- 启动自愈等场景: 只更新传入的非空字段 -->
    <update id="updateZlmServer" parameterType="ZlmServer">
        UPDATE zlm_server
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="app != null">app = #{app},</if>
            <if test="host != null and host != ''">host = #{host},</if>
            <if test="api_port != null">api_port = #{api_port},</if>
            <if test="media_http_port != null">media_http_port = #{media_http_port},</if>
            <if test="media_rtsp_port != null">media_rtsp_port = #{media_rtsp_port},</if>
            <if test="secret != null and secret != ''">secret = #{secret},</if>
            <if test="enabled != null">enabled = #{enabled},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
