<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.waring.mapper.WvpServerMapper">

    <resultMap id="WvpServerResult" type="com.ruoyi.waring.domain.WvpServer">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="host" column="host"/>
        <result property="api_port" column="api_port"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="enabled" column="enabled"/>
    </resultMap>

    <select id="selectEnabledById" resultMap="WvpServerResult">
        SELECT
            id,
            name,
            host,
            api_port,
            username,
            password,
            enabled
        FROM wvp_server
        WHERE id = #{id}
          AND enabled = 1
        LIMIT 1
    </select>

</mapper>
